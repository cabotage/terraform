apiVersion: apps/v1
kind: StatefulSet
metadata:
  namespace: cabotage
  name: seaweedfs-s3
  labels:
    app: seaweedfs
    component: s3
    cabotage.io/infra: "true"
spec:
  serviceName: seaweedfs
  replicas: ${replicas}
  selector:
    matchLabels:
      app: seaweedfs
      component: s3
  podManagementPolicy: Parallel
  updateStrategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        app: seaweedfs
        component: s3
        ca-admission.cabotage.io: "true"
        cabotage.io/infra: "true"
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchExpressions:
                  - key: app
                    operator: In
                    values:
                      - seaweedfs
                  - key: component
                    operator: In
                    values:
                      - s3
              topologyKey: failure-domain.beta.kubernetes.io/zone
      securityContext:
        runAsNonRoot: true
        runAsUser: 20003
        runAsGroup: 20003
        fsGroup: 20003
        fsGroupChangePolicy: "OnRootMismatch"
      serviceAccountName: seaweedfs
      initContainers:
      - name: init-tls
        image: busybox:1.37
        imagePullPolicy: IfNotPresent
        command: ["/bin/sh"]
        args:
          - -c
          - >-
              ln -s /etc/tls/seaweedfs-csi/tls.crt /etc/tls/seaweedfs/tls.crt &&
              ln -s /etc/tls/seaweedfs-csi/tls.key /etc/tls/seaweedfs/tls.key &&
              ln -s /etc/tls/seaweedfs-csi/ca.crt /etc/tls/seaweedfs/ca.crt
        volumeMounts:
        - name: tls-csi
          mountPath: /etc/tls/seaweedfs-csi
          readOnly: true
        - name: tls
          mountPath: /etc/tls/seaweedfs
      containers:
      - name: s3
        image: ${seaweedfs_image}
        imagePullPolicy: IfNotPresent
        args:
          - "s3"
          - "-ip.bind=0.0.0.0"
          - "-port=9000"
          - "-filer=${filer_peers}"
          - "-cert.file=/etc/tls/seaweedfs/tls.crt"
          - "-key.file=/etc/tls/seaweedfs/tls.key"
        ports:
        - containerPort: 9000
          name: s3
        livenessProbe:
          tcpSocket:
            port: 9000
          initialDelaySeconds: 10
          periodSeconds: 15
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          tcpSocket:
            port: 9000
          initialDelaySeconds: 10
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        resources:
          requests:
            cpu: "${resources.requests.cpu}"
            memory: "${resources.requests.memory}"
          limits:
            cpu: "${resources.limits.cpu}"
            memory: "${resources.limits.memory}"
        volumeMounts:
        - name: tls
          mountPath: /etc/tls/seaweedfs
        - name: tls-csi
          mountPath: /etc/tls/seaweedfs-csi
          readOnly: true
      volumes:
        - name: tls
          emptyDir: {}
        - name: tls-csi
          csi:
            driver: csi.cert-manager.io
            readOnly: true
            volumeAttributes:
              csi.cert-manager.io/issuer-name: certificate-approver-ca-issuer
              csi.cert-manager.io/issuer-kind: ClusterIssuer
              csi.cert-manager.io/duration: 9000h  # 375 days
              csi.cert-manager.io/dns-names: >
                $${POD_NAME}.seaweedfs.$${POD_NAMESPACE}.svc.cluster.local,
                seaweedfs.$${POD_NAMESPACE}.svc.cluster.local,
                seaweedfs.$${POD_NAMESPACE}.svc.cluster,
                seaweedfs.$${POD_NAMESPACE}.svc
              csi.cert-manager.io/fs-group: "20003"
              csi.cert-manager.io/certificate-file: "tls.crt"
              csi.cert-manager.io/privatekey-file: "tls.key"
              csi.cert-manager.io/ca-file: "ca.crt"
