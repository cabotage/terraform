apiVersion: apps/v1
kind: StatefulSet
metadata:
  namespace: cabotage
  name: seaweedfs-standalone
  labels:
    app: seaweedfs
    component: standalone
    cabotage.io/infra: "true"
spec:
  serviceName: seaweedfs
  replicas: 1
  selector:
    matchLabels:
      app: seaweedfs
      component: standalone
  podManagementPolicy: Parallel
  updateStrategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        app: seaweedfs
        component: standalone
        # S3 service selector targets component: s3, add it for standalone
        # so the seaweedfs service routes to this pod
        ca-admission.cabotage.io: "true"
        cabotage.io/infra: "true"
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 20003
        runAsGroup: 20003
        fsGroup: 20003
        fsGroupChangePolicy: "OnRootMismatch"
      serviceAccountName: seaweedfs
      initContainers:
      - name: init-permissions
        image: busybox:1.37
        imagePullPolicy: IfNotPresent
        command: ["/bin/sh"]
        args:
          - -c
          - >-
              chown -R 20003:20003 /data &&
              chmod 0750 /data
        securityContext:
          runAsNonRoot: false
          runAsUser: 0
        volumeMounts:
        - name: data
          mountPath: /data
      - name: init-tls
        image: busybox:1.37
        imagePullPolicy: IfNotPresent
        command: ["/bin/sh"]
        args:
          - -c
          - >-
              ln -s /etc/tls/seaweedfs-csi/tls.crt /etc/tls/seaweedfs/tls.crt &&
              ln -s /etc/tls/seaweedfs-csi/tls.key /etc/tls/seaweedfs/tls.key &&
              ln -s /etc/tls/seaweedfs-csi/ca.crt /etc/tls/seaweedfs/ca.crt
        volumeMounts:
        - name: tls-csi
          mountPath: /etc/tls/seaweedfs-csi
          readOnly: true
        - name: tls
          mountPath: /etc/tls/seaweedfs
      containers:
      - name: seaweedfs
        image: ${seaweedfs_image}
        imagePullPolicy: IfNotPresent
        args:
          - "mini"
          - "-ip.bind=0.0.0.0"
          - "-dir=/data"
          - "-s3.port=9000"
          - "-s3.cert.file=/etc/tls/seaweedfs/tls.crt"
          - "-s3.key.file=/etc/tls/seaweedfs/tls.key"
        ports:
        - containerPort: 9333
          name: master
        - containerPort: 9340
          name: volume
        - containerPort: 8888
          name: filer
        - containerPort: 9000
          name: s3
        - containerPort: 23646
          name: admin
        - containerPort: 7333
          name: webdav
        livenessProbe:
          httpGet:
            path: /cluster/status
            port: 9333
            scheme: HTTP
          initialDelaySeconds: 10
          periodSeconds: 15
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /cluster/status
            port: 9333
            scheme: HTTP
          initialDelaySeconds: 10
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        resources:
          requests:
            cpu: "${resources.requests.cpu}"
            memory: "${resources.requests.memory}"
          limits:
            cpu: "${resources.limits.cpu}"
            memory: "${resources.limits.memory}"
        volumeMounts:
        - name: tls
          mountPath: /etc/tls/seaweedfs
        - name: tls-csi
          mountPath: /etc/tls/seaweedfs-csi
          readOnly: true
        - name: data
          mountPath: /data
      volumes:
        - name: tls
          emptyDir: {}
        - name: tls-csi
          csi:
            driver: csi.cert-manager.io
            readOnly: true
            volumeAttributes:
              csi.cert-manager.io/issuer-name: certificate-approver-ca-issuer
              csi.cert-manager.io/issuer-kind: ClusterIssuer
              csi.cert-manager.io/duration: 9000h  # 375 days
              csi.cert-manager.io/dns-names: >
                $${POD_NAME}.seaweedfs.$${POD_NAMESPACE}.svc.cluster.local,
                seaweedfs.$${POD_NAMESPACE}.svc.cluster.local,
                seaweedfs.$${POD_NAMESPACE}.svc.cluster,
                seaweedfs.$${POD_NAMESPACE}.svc
              csi.cert-manager.io/fs-group: "20003"
              csi.cert-manager.io/certificate-file: "tls.crt"
              csi.cert-manager.io/privatekey-file: "tls.key"
              csi.cert-manager.io/ca-file: "ca.crt"
  volumeClaimTemplates:
  - metadata:
      name: data
    spec:
      accessModes:
        - ReadWriteOnce
      resources:
        requests:
          storage: ${volume_storage_size}
