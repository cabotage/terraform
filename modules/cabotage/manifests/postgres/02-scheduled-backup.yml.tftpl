apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: cabotage
  namespace: postgres
  labels:
    cabotage.io/infra: "true"
spec:
  schedule: ${jsonencode(schedule)}
  immediate: ${immediate}
  backupOwnerReference: self
  method: plugin
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
  cluster:
    name: cabotage
  target: prefer-standby
